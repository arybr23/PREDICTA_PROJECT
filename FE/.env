# The frontend must talk to the API same-origin: /api is proxied by the Vite
# dev server (vite.config.js) in development and rewritten by Vercel
# (vercel.json) in production. A cross-site absolute URL makes the browser
# treat the session cookie as third-party, which it then refuses to store or
# send — every request comes back 401 "Not logged in".
VITE_API_URL=/api

# Only uncomment to bypass the proxy deliberately (e.g. local frontend against
# the deployed API without a local backend running):
# VITE_API_URL=https://predicta-project-backend.vercel.app/api
